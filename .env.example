# Firebase Web SDK (Vite - usado em deploys externos como Vercel / Netlify)
# No AI Studio, a configuração provisionada em firebase-applet-config.json é usada automaticamente como fallback.
VITE_FIREBASE_API_KEY="SUA_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="SEU_PROJETO.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="SEU_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="SEU_PROJETO.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="SEU_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Opcional: defina apenas se estiver usando um banco Firestore nomeado diferente de "(default)"
# VITE_FIREBASE_DATABASE_ID="ai-studio-igrejabatistanov-c830bc08-c0ee-426c-8ba6-afd8a630704e"

# APP_URL: URL pública onde a aplicação está hospedada (opcional)
APP_URL="MY_APP_URL"

# YouTube Sync (somente servidor / Vercel Environment Variables — nunca use prefixo VITE_)
# O canal já sincroniza pregações (via RSS) e lives automaticamente sem chave.
# Opcional: adicione uma chave gratuita da YouTube Data API v3 para detecção de live via API oficial.
YOUTUBE_CHANNEL_ID="UCFRiks_8zTRq8zcuUq0sjJw"
YOUTUBE_API_KEY=
